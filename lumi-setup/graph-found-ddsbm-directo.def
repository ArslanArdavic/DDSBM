Bootstrap: localimage
From: /project/project_465002822/containers/graph-found-20260326.sif

%post
    . /opt/venv/bin/activate

    pip install "omegaconf==2.3.0"
    pip install "hydra-core==1.3.2"
    pip install \
        rdkit \
        "PyGSP==0.5.1" \
        "imageio==2.31.1" \
        "seaborn==0.13.2" \
        "overrides==7.3.1" \
        "gpustat==0.6.0"

    pip install \
        pygmtools \
        "toolz" \
        "pyemd==1.0.0" \
        "fire==0.7.0" \
        "fcd-torch==1.0.7"

    pip install "git+https://github.com/fabriziocosta/EDeN.git" --no-deps
    pip install future

    apt-get update -y && apt-get install -y gnupg2 curl build-essential
    echo "deb [ arch=amd64 ] https://downloads.skewed.de/apt noble main" \
        > /etc/apt/sources.list.d/graph-tool.list
    curl -s https://keys.openpgp.org/vks/v1/by-fingerprint/793CEFE14DBC851A2BFB1222612DEFB798507F25 \
        | apt-key add -
    apt-get update -y
    apt-mark hold systemd systemd-dev udev libudev1 libsystemd0 libsystemd-shared
    apt-get install -y --no-install-recommends python3-graph-tool

    SITE=$(/opt/venv/bin/python -c "import site; print(site.getsitepackages()[0])")
    echo "/usr/local/lib/python3.12/dist-packages" > "$SITE/graph_tool_system.pth"

    pip install "numpy<2.0"

%labels
    BaseImage graph-found-20260326.sif
    NOTE_code_patches "See PATCHING.md: torchmetrics 1.x, PL 2.6.x, spe_out_dim fix"
    NOTE_pythonpath "Set PYTHONPATH=.../DDSBM/src:.../DIRECTO/src in SLURM scripts"
    NOTE_orca "Compile once manually after build — only needed for comm20/planar, not zinc"
    NOTE_dgl "Verify DGL not imported in integrated DIRECTO components before closing this"
